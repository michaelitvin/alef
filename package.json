{
  "name": "alef",
  "version": "1.0.0",
  "private": true,
  "description": "Hebrew Reading Game for First Graders",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src tools --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:full": "vitest run --maxWorkers=6",
    "depcruise": "depcruise src tools --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm run lint && npm run depcruise && npm run knip"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "fflate": "0.8.2",
    "framer-motion": "^12.23.26",
    "howler": "^2.2.4",
    "js-yaml": "^4.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-yaml": "^4.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "playwright": "^1.65.1",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.54.0"
  }
}
